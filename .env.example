# Daily Proof — payment configuration
# Copy to .env.local and fill in real values from the Stripe dashboard.
# The app runs fine without these; payment buttons will say payments
# are not configured until every value below is present.

# Server-only. Never expose client-side, never commit real values.
STRIPE_SECRET_KEY=

# Safe for the browser (pk_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price IDs from Stripe Products: $7/month recurring, $70 one-time.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Signing secret for the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for checkout redirect URLs, e.g. https://dailyproof.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Access codes (no accounts) ----------
# Secret used to sign and verify access codes and Stripe-derived licenses.
# Generate with: openssl rand -hex 32
# Mint codes with: LICENSE_SIGNING_SECRET=... node scripts/generate-codes.mjs --role beta --days 60
LICENSE_SIGNING_SECRET=

# Optional, comma-separated: retired signing keys that must still verify.
# To rotate LICENSE_SIGNING_SECRET without logging out every current holder
# of a code or license: move its current value here first (comma-append if
# one is already here), then set LICENSE_SIGNING_SECRET to a new value. Only
# the current key is ever used to sign something new; every key listed here
# is still accepted when verifying. Drop an old key once nothing signed
# under it can still be outstanding (past its longest possible expiry).
LICENSE_SIGNING_SECRET_PREVIOUS=

# Optional: Upstash Redis for gift-code use limits, revocation, and
# Stripe-driven license records. Everything works without these; signed
# codes are then unlimited-use until their expiry.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Founding Beta (Loops) ----------
# API key from loops.so — used server-side only to add beta invitation
# contacts. The email is used for the invitation, nothing else.
LOOPS_API_KEY=

# ---------- Restore access (Loops transactional) ----------
# Reuses LOOPS_API_KEY above. Create a transactional email template in the
# Loops dashboard with a {{restoreLink}} variable, then paste its id here.
# Without this set, POST /api/access/restore returns "not_configured" and
# the restore-access UI is not offered (see BETA_MODE below — restore is
# also hidden entirely during beta, since there are no Stripe purchases yet).
LOOPS_RESTORE_TRANSACTIONAL_ID=

# ---------- Launch switch ----------
# Daily Proof has launched. "0" (current, default) = the live public site:
# full pricing, Stripe checkout, "Open Daily Proof" everywhere. Set to "1"
# only to temporarily fall back to the invite-only beta flow (e.g. pausing
# public signups in an emergency) — the beta request form and its API route
# are kept, dormant, for exactly that case, not deleted.
NEXT_PUBLIC_BETA_MODE=0
