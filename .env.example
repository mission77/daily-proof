# Daily Proof — payment configuration
# Copy to .env.local and fill in real values from the Stripe dashboard.
# The app runs fine without these; payment buttons will say payments
# are not configured until every value below is present.

# Server-only. Never expose client-side, never commit real values.
STRIPE_SECRET_KEY=

# Safe for the browser (pk_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Price IDs from Stripe Products: $7/month recurring, $70 one-time.
STRIPE_MONTHLY_PRICE_ID=
STRIPE_LIFETIME_PRICE_ID=

# Signing secret for the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# Absolute origin used for checkout redirect URLs, e.g. https://dailyproof.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Access codes (no accounts) ----------
# Secret used to sign and verify access codes. Generate with:
#   openssl rand -hex 32
# Mint codes with: LICENSE_SIGNING_SECRET=... node scripts/generate-codes.mjs --role beta --days 60
LICENSE_SIGNING_SECRET=

# Optional: Upstash Redis for gift-code use limits, revocation, and
# Stripe-driven license records. Everything works without these; signed
# codes are then unlimited-use until their expiry.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Founding Beta (Loops) ----------
# API key from loops.so — used server-side only to add beta invitation
# contacts. The email is used for the invitation, nothing else.
LOOPS_API_KEY=

# ---------- Launch switch ----------
# "1" (default) = pre-launch beta site: checkout hidden, invitation flow on.
# Set to "0" at public launch to restore pricing and Stripe checkout.
NEXT_PUBLIC_BETA_MODE=1
